{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ukr-proverbs-corpus",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "UPA",
      "service": "upa-local-preview"
    }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "proverbs-bge-m3-v2"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "NEWS_KV",
      "id": "b9bcfa756c624727b2489f0faf7d3350"
    }
  ],
  "routes": [
    {
      "pattern": "verbacorpus.org",
      "custom_domain": true
    },
    {
      "pattern": "www.verbacorpus.org",
      "custom_domain": true
    },
    {
      "pattern": "pro.verbacorpus.org",
      "custom_domain": true
    },
    {
      "pattern": "contra.verbacorpus.org",
      "custom_domain": true
    },
    {
      "pattern": "re.verbacorpus.org",
      "custom_domain": true
    },
    {
      "pattern": "para.verbacorpus.org",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "0 6 * * *"
    ]
  },
  "rules": [
    {
      "type": "Data",
      "globs": [
        "**/*.ttf"
      ],
      "fallthrough": true
    }
  ]
}
