{"font":{"format":"para-font","schemaVersion":"2.0.0","id":"hoard-dec-vt320","name":"VT320","family":"Vt-Glyphs1.PngVt-Glyphs2","version":1,"kind":"native","availability":"raster","cell":{"width":15,"height":12,"monospace":true,"pixelAspectRatio":{"x":1,"y":1}},"metrics":{"ascent":12,"descent":0,"baseline":12,"lineGap":0,"lineHeight":12,"advanceX":15},"bitmap":{"encoding":"hex-rows","bitOrder":"msb-first","bitsPerPixel":1},"encodings":[{"name":"unmapped","primary":true}],"license":{"id":"NOASSERTION","name":"Original source terms retained","status":"unverified","redistributionAllowed":null,"attributionRequired":true,"attribution":"Hoard of Bitfonts by Rob Hagemans; verify the original font source before use.","url":"https://github.com/robhagemans/hoard-of-bitfonts/blob/master/LICENSE.md","sourceNotices":[{"path":"LICENSE.md","sha256":"f9c9b38b2696d0ed0c8df900ec1b84b08e15d63d71c52829fb5f4deb5089794e","text":"Copyrights\n----------\n\nIt is my understanding that:  \n\n- In the USA, bitmap typefaces are not copyrightable.  \n- In the UK, the 25-year term of copyright for these typefaces has expired.  \n\nHowever, you should ensure that you have the right to copy and use these typefaces in your jurisdiction.  \n\n\nLicensing\n---------\n\nNotwithstanding the above, in several cases explicit licensing terms were provided.\nPlease refer to the individual sources and directories for such terms.  \n\nInsofar as I have created copyrightable work by representing these typefaces in their present form:\nto the extent possible under law, I waive all copyright\nand related or neighbouring rights to that additional work under the\n[Creative Commons Zero dedication](http://creativecommons.org/publicdomain/zero/1.0/).\n\n\n"},{"path":"README.md","sha256":"37ec8194c3a66313d65edc1fdd76b0e7218f1d0956268a32257376ed1a8e1a00","text":"Bitmap fonts for humans\n-----------------------\n\nThis repository contains bitmapped fonts from disused operating systems and graphical user interfaces.\n\nAs operating systems and GUIs have moved on to scalable vector fonts, the bitmap fonts that dominated\nthe 1980s and 1990s languish away in non-obvious and often binary formats that are rapidly falling\ninto obscurity.\n\nThe main purpose of this repository is to liberate these fonts from their binary shackles,\npreserving the ancient art of monochrome bitmap typography for human appreciation.\n\nThe fonts in this repository are stored in [the human-friendly text-based YAFF format](https://github.com/robhagemans/monobit/blob/master/YAFF.md).\nAs such, the easiest way to view them is to open the text files directly. Alternatively, you can use\n[`monobit`](https://github.com/robhagemans/monobit) to render them to images or convert them to\nfont formats supported by current operating systems. You can also\n[see the fonts as images here](http://robhagemans.github.io/monobit/).\n"}],"copyright":"","sourceLicense":""},"source":{"collection":"hoard","recordId":"hoard-dec-vt320","revision":"d11f085795149f7d246d365abd98b91d56b0789d","sha256":"c2b994193d45064e79ae4449238cb0ffac65b11fdcef7f88d2182a5a4f226494","upstream":{"name":"Hoard of Bitfonts","url":"https://vt100.net/dec/vt320/glyphs","collectionUrl":"https://github.com/robhagemans/hoard-of-bitfonts/","author":"Rob Hagemans","retrievedAt":"2026-07-21","revision":"d11f085795149f7d246d365abd98b91d56b0789d","file":"dec/vt320.yaff","fileSha256":"c2b994193d45064e79ae4449238cb0ffac65b11fdcef7f88d2182a5a4f226494","packIndex":0}},"provenance":{"decoder":"monobit 0.52.0","nativeGlyphs":294,"packIndex":0,"sourceHeader":"","rasterSha256":"507957500b3ae064ff94632fc6054bb07add8cc997884c3c0b1991ebba8a799e","transformation":"Native glyph rasters and metrics; no resizing, thresholding or invented Unicode labels."},"modifications":[],"coverage":{"glyphCount":294,"unicodeGlyphCount":261,"unmappedGlyphCount":33,"ukrainian":{"required":66,"present":0,"missing":["А","Б","В","Г","Ґ","Д","Е","Є","Ж","З","И","І","Ї","Й","К","Л","М","Н","О","П",