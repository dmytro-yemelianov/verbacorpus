{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ukr-proverbs-corpus-preview",
  "main": "src/preview.ts",
  "compatibility_date": "2025-10-11",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "services": [{ "binding": "UPA", "service": "upa-local-preview" }],
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "proverbs-bge-m3-v2" }],
  "observability": { "enabled": true },
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }]
}
